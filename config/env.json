{
  "skill": "bazi",
  "spec_version": "v4",
  "python": {
    "min_version": "3.6",
    "tested_versions": ["3.12.10", "3.13.12"],
    "third_party_required": [],
    "note": "全部脚本只用 Python 标准库。third_party_required 为空即为设计目标：拷走即可用，不需要 pip、不需要联网。"
  },
  "pip_index_url": "https://pypi.tuna.tsinghua.edu.cn/simple",
  "required_files": [
    "SKILL.md",
    "README.md",
    "config/env.json",
    "scripts/pai_pan.py",
    "scripts/intake.py",
    "scripts/setup_env.py",
    "scripts/shensha_engine.py",
    "scripts/wuxing_engine.py",
    "scripts/tiaohou_engine.py",
    "scripts/huofa_layer.py",
    "scripts/monthly_scan_gen.py",
    "scripts/zhi_rel.py",
    "references/delivery-spec.md",
    "references/falsifiable-protocol.md",
    "references/framework-map.md",
    "references/huofa-layer.md",
    "references/shishen-xiang.md",
    "references/xiang-guard.md",
    "references/blunt-mode.md",
    "references/wuxing-tables.md",
    "references/shensha-table.md",
    "references/shichen-table.md",
    "references/dayun-rules.md",
    "references/tiaohou-table.md",
    "references/classical-texts.md",
    "assets/盘卡模板.md",
    "assets/盘卡示例.md"
  ],
  "entrypoints": [
    {"script": "scripts/setup_env.py", "desc": "环境自检与调配（开局先跑这一条）"},
    {"script": "scripts/pai_pan.py", "desc": "排盘：四柱 / 大运 / 流年"},
    {"script": "scripts/intake.py", "desc": "整盘一次喂进：排盘 + 神煞22条 + 五行 + 调候"},
    {"script": "scripts/huofa_layer.py", "desc": "活法层：纳音 / 胎元 / 命宫 / 羊刃 / 空亡 / 天乙 / 派生神煞"},
    {"script": "scripts/monthly_scan_gen.py", "desc": "逐月推演扫描（通用版）"},
    {"script": "scripts/shensha_engine.py", "desc": "神煞引擎（22 条全跑）"},
    {"script": "scripts/wuxing_engine.py", "desc": "五行力量引擎"},
    {"script": "scripts/tiaohou_engine.py", "desc": "调候用神引擎"}
  ],
  "local_modules": ["pai_pan", "intake", "shensha_engine", "wuxing_engine", "tiaohou_engine", "huofa_layer", "monthly_scan_gen", "zhi_rel"],
  "smoke_tests": [
    {
      "script": "scripts/intake.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申", "--sex", "男"],
      "expect": ["四柱", "神煞", "五行力量", "调候用神"],
      "desc": "整盘机械层（假盘，非真实命盘）"
    },
    {
      "script": "scripts/pai_pan.py",
      "args": ["--solar", "1990-05-15", "--hour", "12:00", "--sex", "男"],
      "expect": ["四柱", "大运", "流年"],
      "desc": "出生信息模式（假盘，非真实命盘）"
    },
    {
      "script": "scripts/huofa_layer.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申"],
      "expect": ["纳音", "胎元", "羊刃"],
      "desc": "活法层（假盘，非真实命盘）"
    },
    {
      "script": "scripts/monthly_scan_gen.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申", "--start", "2026-10", "--end", "2027-03", "--out", "__SMOKE_OUT__"],
      "expect": ["完成"],
      "expect_file": ["逐月推演", "机械计算层", "月柱"],
      "desc": "逐月推演（假盘，非真实命盘）"
    },
    {
      "script": "scripts/shensha_engine.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申", "--sex", "男"],
      "expect": ["神煞"],
      "desc": "神煞引擎单跑（假盘，非真实命盘）"
    },
    {
      "script": "scripts/wuxing_engine.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申"],
      "expect": ["五行"],
      "desc": "五行引擎单跑（假盘，非真实命盘）"
    },
    {
      "script": "scripts/tiaohou_engine.py",
      "args": ["--pillars", "甲子,丙寅,戊午,庚申"],
      "expect": ["调候"],
      "desc": "调候引擎单跑（假盘，非真实命盘）"
    }
  ]
}
